/* Colors are inherited from the editor theme wherever possible; only tints that must contrast with the
   Light or Dark skin are set explicitly, through the root's event-debugger--light / --dark class. */

.event-debugger {
    flex-grow: 1;
}

.event-debugger__spacer {
    flex-grow: 1;
}

.event-debugger__search {
    width: 200px;
    flex-shrink: 1;
}

.event-debugger__bus-menu {
    min-width: 120px;
    max-width: 260px;
}

.event-debugger__body {
    flex-grow: 1;
}

.event-debugger__list {
    flex-grow: 1;
}

.event-debugger__empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0.6;
}

.event-debugger__time-probe {
    position: absolute;
    visibility: hidden;
}

.trace-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
}

.trace-row--chain-start {
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.45);
}

.trace-row__time {
    flex-shrink: 0;
    margin: 0 6px 0 0;
    padding: 0;
    opacity: 0.55;
    -unity-text-align: middle-left;
}

.trace-row__indent {
    flex-direction: row;
    flex-shrink: 0;
    align-self: stretch;
}

.trace-row__indent-guide {
    width: 18px;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.4);
}

.trace-row__icon,
.trace-row__connector {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
}

.trace-row__icon--publisher {
    background-image: url("../Textures/publisher.png");
}

.trace-row__icon--event {
    background-image: url("../Textures/event.png");
}

.trace-row__connector {
    margin: 0 5px;
}

.trace-row__connector--broadcast {
    background-image: url("../Textures/broadcast.png");
}

.trace-row__connector--arrow {
    background-image: url("../Textures/arrow-right.png");
}

.event-debugger--dark .trace-row__connector {
    -unity-background-image-tint-color: rgb(210, 210, 210);
}

.event-debugger--light .trace-row__connector {
    -unity-background-image-tint-color: rgb(70, 70, 70);
}

.trace-row__label {
    flex-shrink: 1;
    margin: 0 0 0 3px;
    padding: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.trace-row__label--trailing {
    flex-grow: 1;
}

.trace-row__bus {
    flex-shrink: 0;
    max-width: 35%;
    margin: 0 0 0 8px;
    padding: 0;
    opacity: 0.55;
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
}
